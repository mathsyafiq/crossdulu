---
import "@fontsource-variable/newsreader/opsz.css";
import "../styles/tokens.css";
import "../styles/global.css";
import { dict, SITE_NAME, path, type PageKey } from "../i18n/strings";

interface Props {
  page: PageKey;
  title: string;
  description: string;
  noindex?: boolean;
  /** Full-bleed main: the page lays out its own bands and widths (the home page). */
  bleed?: boolean;
}
const { page, title, description, noindex, bleed } = Astro.props;
const d = dict;
const canonical = Astro.site ? new URL(path(page), Astro.site).href : undefined;
---
<!doctype html>
<html lang={d.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: mediastream:; worker-src 'self' blob:; font-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'self'; object-src 'none'" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#f6f8f7" />
  </head>
  <body class={page === "home" ? "is-home" : undefined}>
    <a class="skip" href="#main">{d.nav.skip}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={path("home")}>{SITE_NAME}</a>
        <nav aria-label="Main" class="nav">
          <a href={path("editor")} aria-current={page === "editor" ? "page" : undefined}>{d.nav.editor}</a>
          <a href={path("privacy")} aria-current={page === "privacy" ? "page" : undefined}>{d.nav.privacy}</a>
          <a href={path("terms")} aria-current={page === "terms" ? "page" : undefined}>{d.nav.terms}</a>
        </nav>
      </div>
    </header>
    <main id="main" class={bleed ? undefined : "wrap"}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <span class="brand small-brand">{SITE_NAME}</span>
        <span>{d.footer}</span>
      </div>
    </footer>
  </body>
</html>
