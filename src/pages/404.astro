---
import Base from "../layouts/Base.astro";
import { SITE_NAME, path } from "../i18n/strings";
---
<Base page="home" title={`Page not found: ${SITE_NAME}`} description="That address does not exist or has moved. Go back to the Crossdulu home page." noindex>
  <section class="prose" style="padding-top: var(--space-7)">
    <h1>Page not found</h1>
    <p>That address does not exist or has moved.</p>
    <p><a class="btn primary" href={path("home")}>Go to the home page</a></p>
  </section>
</Base>
